{
  "name": "@codesbegin/harness-finance",
  "description": "DDD double-entry ledger for agents, backed by OWL ontology reasoning (FIBO-aligned). Cordis-based finance plugin: natural-language bookkeeping for OPCs, solopreneurs, and small teams.",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./service": { "types": "./lib/service.d.ts", "default": "./lib/service.js" },
    "./tool": { "types": "./lib/tool.d.ts", "default": "./lib/tool.js" },
    "./ontology": { "types": "./lib/ontology/index.d.ts", "default": "./lib/ontology/index.js" },
    "./repository": { "types": "./lib/repository/index.d.ts", "default": "./lib/repository/index.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "ontology/"
  ],
  "license": "UNLICENSED",
  "keywords": [
    "bookkeeping",
    "double-entry",
    "agent",
    "ddd",
    "cordis",
    "ontology",
    "owl",
    "rdf",
    "finance",
    "ledger"
  ],
  "homepage": "https://github.com/codesbegin/harness-finance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codesbegin/harness-finance.git"
  },
  "bugs": {
    "url": "https://github.com/codesbegin/harness-finance/issues"
  },
  "author": {
    "name": "codesbegin",
    "url": "https://github.com/codesbegin"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --import tsx --test test/*.test.ts",
    "reason": "tsx scripts/reason.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "n3": "^0.1.x",
    "rdf-reasoner-konclude": "^0.8.x",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/n3": "^1.16.x",
    "n3": "^0.1.x",
    "rdf-reasoner-konclude": "^0.8.x",
    "tsdown": "^0.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "zod": "^3.0.0"
  }
}
