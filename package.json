{
  "name": "@codesbegin/harness-finance",
  "description": "DDD double-entry ledger for agents, backed by OWL ontology reasoning (FIBO-aligned). Cordis-based finance plugin: natural-language bookkeeping for OPCs, solopreneurs, and small teams.",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./ontology": {
      "types": "./lib/ontology/index.d.ts",
      "default": "./lib/ontology/index.js"
    },
    "./repository": {
      "types": "./lib/repository/index.d.ts",
      "default": "./lib/repository/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "ontology/"
  ],
  "license": "UNLICENSED",
  "keywords": [
    "bookkeeping",
    "double-entry",
    "agent",
    "ddd",
    "cordis",
    "ontology",
    "owl",
    "rdf",
    "finance",
    "ledger"
  ],
  "homepage": "https://github.com/codesbegin/harness-finance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codesbegin/harness-finance.git"
  },
  "bugs": {
    "url": "https://github.com/codesbegin/harness-finance/issues"
  },
  "author": {
    "name": "codesbegin",
    "url": "https://github.com/codesbegin"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsdown",
    "test": "node --import tsx --test --test-force-exit test/*.test.ts",
    "dev": "node --import tsx scripts/dev.ts",
    "reason": "tsx scripts/reason.ts",
    "reason:dot": "tsx scripts/reason.ts --export-dot docs/tbox.dot",
    "reason:abox": "tsx scripts/reason.ts --abox ontology/sample.abox.json",
    "reason:abox-dot": "tsx scripts/reason.ts --abox ontology/sample.abox.json --export-abox-dot docs/abox.dot"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "better-sqlite3": "11.10.0",
    "n3": "1.17.2",
    "rdf-reasoner-konclude": "0.8.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/n3": "^1.26.6",
    "tsdown": "^0.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
