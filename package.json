    "./tool": { "types": "./lib/tool.d.ts", "default": "./lib/tool.js" },
    "./ontology": { "types": "./lib/ontology/index.d.ts", "default": "./lib/ontology/index.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "ontology/"
  ],
  "license": "UNLICENSED",
